# AUREON Phase 5 — optional AI assistance
#
# Copy this file to ".env" and fill in at least one key to enable the
# AI layer. The client tries Gemini first, then falls back to Groq.
# Both offer generous free tiers:
#   - Gemini: https://aistudio.google.com/app/apikey   (~1500 req/day free)
#   - Groq:   https://console.groq.com/keys            (~1000 req/day free)

GEMINI_API_KEY=
GROQ_API_KEY=

# Optional overrides (defaults shown)
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
